# Copy this file to `.env` and fill that one in. Git ignores `.env`; this file it does not, so
# here the keys stay empty.

# Jev, from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# OpenRouter, from https://openrouter.ai/settings/keys. A key can be given a credit limit there.
OPENROUTER_API_KEY=

# The model the integration tests ask through OpenRouter. Any cheap one that returns JSON will do.
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
